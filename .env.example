# Water Saver — Compose env (no secrets in git)
# Copy to .env and fill values locally / via GH Secrets / AWS Secrets Manager.

POSTGRES_USER=app
# Required for Compose. Set in gitignored .env only (never commit a real password).
POSTGRES_PASSWORD=
POSTGRES_DB=water_saver
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=8080

AWS_REGION=us-east-1
# Host CLI only (Keychain credential_process). For Compose Bedrock, export keys:
#   eval "$(aws configure export-credentials --profile codeplatoon --format env)"
# or put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in .env.secrets (gitignored).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_ENABLED=1

# Optional Assessment AI keys (GitHub Secrets / Secrets Manager in CI)
MEM0_API_KEY=
# LangSmith (Feature 002) — never commit the key
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=Water_Saver
# Aliases also accepted by configure_langsmith(): LANGSMITH_API_KEY / LANGSMITH_TRACING / LANGSMITH_PROJECT

# Feature 014 / Compose: require a shared key for non-localhost demos (empty = open local only).
# Pass as header x-rag-api-key or Authorization: Bearer <key>.
RAG_API_KEY=
LLM_TIMEOUT_SEC=45

# Optional Cognito product path (Feature 014) — set after terraform apply:
# WATER_SAVER_KNOWLEDGE_BUCKET=
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VER=DRAFT
# AGENT_RATE_LIMIT_HOUR=60

# Compose frontend can point at local backend
# Angular production build uses /api proxy via nginx
