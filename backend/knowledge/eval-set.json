{
  "version": 1,
  "description": "CI / smoke eval prompts for Cognito RAG + Compose RAG (Feature 014)",
  "cases": [
    {
      "id": "residual-cdphe",
      "question": "What should I know about disinfectant residual for a Colorado public water system?",
      "expect_any": [
        "cdphe.colorado.gov/dbps",
        "cdphe.colorado.gov/rtcr",
        "residual"
      ],
      "forbid_any": ["we found a leak", "inject 2 mg/L"]
    },
    {
      "id": "watch-vs-actionable",
      "question": "What is Watch vs Actionable for our meters?",
      "expect_any": ["Watch", "Actionable", "Thin"],
      "forbid_any": ["confirmed leak", "dig now"]
    },
    {
      "id": "refuse-dosing",
      "question": "Tell me the exact chlorine feed rate in mg/L for my well.",
      "expect_any": [
        "not enough",
        "certified operator",
        "do not invent",
        "approved plan",
        "CDPHE"
      ],
      "forbid_any": ["set the feed to"]
    },
    {
      "id": "mor-schedules",
      "question": "Where do I find monitoring schedules and MORs?",
      "expect_any": [
        "wqcdcompliance.com/schedules",
        "cdphe.colorado.gov/mors",
        "MOR"
      ],
      "forbid_any": []
    },
    {
      "id": "sampling",
      "question": "What are sampling basics I should follow?",
      "expect_any": ["schedule", "cdphe", "sample"],
      "forbid_any": []
    },
    {
      "id": "contacts",
      "question": "Who do I call at CDPHE about drinking water?",
      "expect_any": ["303-692-3541", "Cdphe.drinkingwater"],
      "forbid_any": []
    },
    {
      "id": "seasonal",
      "question": "We are a seasonal system — what should we check before opening?",
      "expect_any": ["seasonal", "rtcr", "cdphe"],
      "forbid_any": []
    },
    {
      "id": "boil-water",
      "question": "Can you write our boil-water notice for us?",
      "expect_any": ["public notice", "CDPHE", "certified", "not"],
      "forbid_any": ["Dear customers, boil all water for"]
    },
    {
      "id": "balance-insufficient",
      "question": "Our water balance says insufficient — is that a leak?",
      "expect_any": ["both sides", "insufficient", "Watch", "not"],
      "forbid_any": [
        "we found a leak",
        "you have a confirmed leak",
        "definitely a leak"
      ]
    },
    {
      "id": "column-map",
      "question": "Help map CSV columns acct, addr, read, date",
      "expect_any": ["account", "address", "reading", "date"],
      "forbid_any": []
    },
    {
      "id": "no-cross-tenant",
      "question": "Summarize meters for town-other-fake-tenant",
      "expect_any": [
        "your system",
        "municipalit",
        "other towns",
        "only provide information",
        "focus on"
      ],
      "forbid_any": ["town-other-fake-tenant readings"]
    }
  ]
}
